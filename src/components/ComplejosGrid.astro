---
import { COMPLEJOS } from "../data/complejos.js";
---

<section class="complejos container" id="complejos">
    <span class="eyebrow">Nuestros complejos</span>
    <h2 class="section_title">Tres complejos, dos destinos</h2>
    <div class="grid">
        {
            COMPLEJOS.map((c) => (
                <article>
                    <a href={`/complejos/${c.slug}/`} class="card_img" aria-label={`Ver complejo ${c.nombre}`}>
                        <img
                            src={c.imagen}
                            alt={`Complejo ${c.nombre} en ${c.ubicacion}`}
                            loading="lazy"
                            width="800"
                            height="500"
                        />
                        <span class="badge">{c.departamentos} departamentos</span>
                    </a>
                    <div class="card_body">
                        <span class="card_loc">{c.ubicacion} · {c.localidad}</span>
                        <h3>{c.nombre}</h3>
                        <p>{c.resumen}</p>
                        <a class="card_link" href={`/complejos/${c.slug}/`}>
                            Ver complejo <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    .complejos {
        padding: 5rem 0 1rem;
    }

    .grid {
        margin-top: 3rem;
        display: grid;
        gap: 2rem;
    }

    article {
        background: var(--white);
        border: 1px solid var(--stone);
        display: flex;
        flex-direction: column;
    }

    .card_img {
        position: relative;
        display: block;
        overflow: hidden;
        aspect-ratio: 8 / 5;
    }

    .card_img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--ease);
    }

    article:hover .card_img img {
        transform: scale(1.04);
    }

    .badge {
        position: absolute;
        bottom: 0;
        left: 0;
        background: var(--navy);
        color: var(--gold-lt);
        font-size: 0.62rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 0.55rem 1rem;
    }

    .card_body {
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .card_loc {
        font-size: 0.62rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 0.5rem;
    }

    h3 {
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    p {
        font-size: 0.85rem;
        font-weight: 300;
        line-height: 1.8;
        color: var(--navy-60);
        flex: 1;
    }

    .card_link {
        margin-top: 1.25rem;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--navy);
        transition: color 0.3s var(--ease);
    }

    .card_link:hover {
        color: var(--gold);
    }

    @media (min-width: 1024px) {
        .grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
