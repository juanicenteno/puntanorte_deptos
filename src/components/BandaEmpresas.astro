---
import { SITE } from "../data/site.js";
const msg = encodeURIComponent(
    "Hola, quiero cotizar alojamiento para mi empresa."
);
---

<section class="banda">
    <div class="banda_content">
        <span class="eyebrow">Convenios corporativos</span>
        <h2>Su equipo, cerca del proyecto</h2>
        <p>
            Minería, energía, obra pública, logística portuaria: la zona de
            Sierra Grande, Punta Colorada y el Golfo San Matías concentra cada
            vez más operaciones. Resolvemos el alojamiento de su personal con
            unidades equipadas, un solo interlocutor y facturación simple.
        </p>
        <div class="banda_actions">
            <a class="btn btn_light" href="/contacto/"><span>Solicitar cotización</span></a>
            <a
                class="btn btn_light"
                href={`https://wa.me/${SITE.whatsapp}?text=${msg}`}
                target="_blank"
                rel="noopener"><span>Escribir por WhatsApp</span></a
            >
        </div>
    </div>
</section>

<style>
    .banda {
        position: relative;
        margin-top: 5rem;
        min-height: 26rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
            radial-gradient(ellipse at center, rgba(20, 36, 46, 0.5) 20%, rgba(20, 36, 46, 0.92) 100%),
            url('/img/carmela-2.webp') center / cover no-repeat;
    }

    .banda_content {
        text-align: center;
        padding: 4rem 2rem;
        width: min(92%, 640px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.1rem;
    }

    h2 {
        font-family: var(--font-display);
        font-size: clamp(1.9rem, 4.5vw, 2.6rem);
        font-weight: 400;
        color: var(--white);
        line-height: 1.2;
    }

    h2::after {
        content: '';
        display: block;
        width: 2rem;
        height: 1px;
        background: var(--gold);
        margin: 0.9rem auto 0;
    }

    p {
        font-size: 0.88rem;
        font-weight: 300;
        line-height: 1.85;
        color: var(--white-70);
    }

    .banda_actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin-top: 0.75rem;
    }
</style>
